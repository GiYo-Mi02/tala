{
  "expo": {
    "name": "T.A.L.A. Pilot",
    "slug": "tala-scanner",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "newArchEnabled": true,
    "android": {
      "package": "ph.tala.scanner.pilot",
      "versionCode": 10,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      "./plugins/with-windows-cmake"
    ],
    "updates": {
      "enabled": false
    }
  }
}
