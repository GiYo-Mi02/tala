# Copy to apps/backend/.env. Supply a dedicated PostgreSQL user and password.
DATABASE_URL=postgresql://tala_owner:CHANGE_ME@127.0.0.1:5432/tala_dev
STORAGE_ROOT=../../.cache/tala-private-images
HOST=127.0.0.1
PORT=8788
NODE_ENV=development
CORS_ORIGINS=
MAX_PAGE_BYTES=10000000
RETAIN_INCOMPLETE_DAYS=30
RATE_LIMIT=120
TRUST_LOOPBACK_PROXY=false
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# WEB_ROOT=../web/dist
